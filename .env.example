AIRFLOW_ADMIN_EMAIL=admin@healthplatform.local
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# --- 5. Apache Superset (Business Intelligence) ---

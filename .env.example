# --- 1. MySQL (OLTP Source - Tiêm chủng nội bộ) ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=vaccination_oltp
MYSQL_USER=oltp_user
MYSQL_PASSWORD=oltp_password

# --- 2. PostgreSQL (Data Warehouse & Metadata DB) ---
POSTGRES_USER=dwh_admin
POSTGRES_PASSWORD=dwh_password
POSTGRES_DB=health_dwh

# --- 3. MinIO (Data Lake / Landing Zone) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=covid19-landing-zone

# --- 4. Apache Airflow (Orchestration) ---
